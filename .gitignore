# =============================================================================
# Root .gitignore — Monorepo Architecture
# =============================================================================

# 1. Dependencies
node_modules/
**/node_modules/

# 2. Compiled Outputs
dist/
**/dist/
build/
**/build/

# 3. Environment Variables (SECURITY: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# Allow example files (they document required env vars)
!.env.example
!**/.env.example

# 4. TypeScript & Build Cache
*.tsbuildinfo
**/*.tsbuildinfo
.turbo/
.cache/

# 5. Logs & Temporary Files
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Test & Coverage Reports
coverage/
**/coverage/
.nyc_output/

# 7. Operating System Files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# 8. IDE & Editor Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.gemini/
.agents/

# 9. Prisma Generated Client (Regenerated via `prisma generate`)
node_modules/.prisma/
**/node_modules/.prisma/

# 10. Docker Volumes & Local Mounts
docker-data/
postgres_data/
**/postgres_data/
