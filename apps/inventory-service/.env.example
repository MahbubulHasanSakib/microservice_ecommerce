TCP_PORT=3006
HTTP_PORT=3016
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_db?schema=public

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_INVENTORY_QUEUE=inventory.queue
RABBITMQ_ORDER_QUEUE=order.queue
RABBITMQ_PAYMENT_QUEUE=payment.queue
RABBITMQ_NOTIFICATION_QUEUE=notification.queue

LOG_LEVEL=debug
