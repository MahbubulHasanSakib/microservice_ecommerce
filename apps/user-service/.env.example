# User Service Environment Variables
# Copy to .env and set real values. Never commit .env.

# TCP microservice port (NestJS ClientProxy connects here)
TCP_PORT=3001

# HTTP port for health check probes (Docker/k8s probes connect here)
HTTP_PORT=3011

# Environment: development | production | test
NODE_ENV=development

# PostgreSQL connection string for user_db
# This service ONLY connects to user_db — never to other service databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_db
