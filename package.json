{
  "name": "ecommerce-microservice-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "lint": "eslint \"{apps,libs}/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.ts\"",
    "test": "npm run test --workspaces --if-present",
    "build:shared": "npm run build --workspace=@ecommerce/shared",
    "build:apps": "npm run build --workspace=@ecommerce/user-service && npm run build --workspace=@ecommerce/auth-service && npm run build --workspace=@ecommerce/product-service && npm run build --workspace=@ecommerce/order-service && npm run build --workspace=@ecommerce/api-gateway",
    "build": "npm run build:shared && npm run build:apps",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@5.1.1": true,
    "fsevents@2.3.3": true
  }
}
