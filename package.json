{
  "name": "ecommerce-microservice-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "lint": "eslint \"{apps,libs}/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.ts\"",
    "test": "npm run test --workspaces --if-present",
    "build:shared": "npm run build --workspace=@ecommerce/shared",
    "build:inventory": "npm run build --workspace=@ecommerce/inventory-service",
    "build:apps": "npm run build --workspace=@ecommerce/user-service && npm run build --workspace=@ecommerce/auth-service && npm run build --workspace=@ecommerce/product-service && npm run build --workspace=@ecommerce/order-service && npm run build --workspace=@ecommerce/inventory-service && npm run build --workspace=@ecommerce/payment-service && npm run build --workspace=@ecommerce/notification-service && npm run build --workspace=@ecommerce/api-gateway",
    "build": "npm run build:shared && npm run build:apps",
    "type-check": "npm run type-check --workspaces --if-present",
    "start:gateway": "npm run start:dev --workspace=@ecommerce/api-gateway",
    "start:auth": "npm run start:dev --workspace=@ecommerce/auth-service",
    "start:user": "npm run start:dev --workspace=@ecommerce/user-service",
    "start:product": "npm run start:dev --workspace=@ecommerce/product-service",
    "start:order": "npm run start:dev --workspace=@ecommerce/order-service",
    "start:inventory": "npm run start:dev --workspace=@ecommerce/inventory-service",
    "start:payment": "npm run start:dev --workspace=@ecommerce/payment-service",
    "start:notification": "npm run start:dev --workspace=@ecommerce/notification-service",
    "start:all": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,AUTH,USER,PRODUCT,ORDER,INVENTORY,PAYMENT,NOTIF\" -c \"cyan,magenta,blue,yellow,green,gray,white,red\" \"npm:start:gateway\" \"npm:start:auth\" \"npm:start:user\" \"npm:start:product\" \"npm:start:order\" \"npm:start:inventory\" \"npm:start:payment\" \"npm:start:notification\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "ioredis": "^5.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@5.1.1": true,
    "fsevents@2.3.3": true
  }
}
